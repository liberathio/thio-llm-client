{
  "name": "@thio/llm-client",
  "version": "0.2.0",
  "description": "Shared LLM client for Thio's agent ecosystem. Wraps Anthropic + OpenAI SDKs with mandatory tagging, alias-only models, and Anthropic's system_and_3 prompt caching strategy. All calls route through the local LiteLLM proxy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.86.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@types/node": "^22.19.17",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "UNLICENSED",
  "private": true
}
